# ---------------------------------------------------------------------------
# Copilot backend environment
# Copy this file to `server/.env` and fill in what you need.
# Phase 2 (WebSocket demo) does NOT need any keys — these are for Phase 3+.
# ---------------------------------------------------------------------------

# Server host/port
HOST=127.0.0.1
PORT=8000

# Comma-separated origins allowed by CORS / WebSocket (3000 and 3001 are defaults)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Playback pacing for the scripted stream (seconds)
STREAM_LINE_DELAY=1.6
STREAM_FINALIZE_DELAY=0.9

# ============================ PHASE 3+ API KEYS ============================
# Phase 3 — speech-to-text (Deepgram)
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Phase 3 — LLM classification (Grok, OpenAI-compatible xAI API)
# https://console.x.ai/
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# Phase 3 — text-to-speech (Cartesia)
# https://play.cartesia.ai/
CARTESIA_API_KEY=
